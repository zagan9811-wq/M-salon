# Port the server listens on (Railway sets this automatically)
PORT=3000

# Where the SQLite file lives. On Railway, attach a volume (e.g. mounted at
# /data) and set this to /data/salon.db so bookings survive redeploys.
DATABASE_PATH=./data/salon.db

# Shop timezone. Every date and time in the app is resolved in this zone.
SHOP_TIMEZONE=Asia/Baghdad

# Price shown on the site and stored with each booking.
PRICE=25
CURRENCY=IQD

# Key for the owner dashboard at /admin. Set a long random string in
# production; the dashboard is disabled while this is empty.
ADMIN_KEY=
